# Generated dumps: large and reproducible via tools/. Small evidence files stay tracked.
# analysis/gpt/disk.img (62.8 GB full-eMMC snapshot) is brick insurance and lives on the HDD archive.
analysis/*/
!analysis/gpt/
analysis/gpt/disk.img
analysis/*.img
out/
out-hu/
prebuilts/
.AOSP
lineage/
aosp/

# OEM reference firmware: on disk here and on the NAS archive
# (/srv/50911774-19fb-46b6-bc9e-8cf81623d044/aospbuild-archive), never in git.
# The dir name "diatsia fw" is the owner's spelling and stays: scripts reference it.
diatsia fw/
update.zip
extracted update.zip/
refs/

# Payload parts and rebuilt images (reproducible from the build tree)
*.img
*.new.dat
*.new.dat.br
*.patch.dat
*.transfer.list

# Probe reports: markdown evidence is tracked, binaries/backups are not
incoming/*
!incoming/*.md

# Python caches
__pycache__/
*.pyc

# Credentials and editor noise (local.env.example stays tracked)
local.env
*.env
.env.*
*.swp
.DS_Store
