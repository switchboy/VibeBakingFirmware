# Generated analysis artefacts (large, reproducible via tools/) - small text artefacts are kept
analysis/*
!analysis/*.txt

# Owner's downloaded vendor firmware (2.7 GB) - never commit
diatsia fw/

# Reference firmware payload: 1.2 GB, kept on disk but never committed
update.zip
extracted update.zip/

# Final flashable payload (copy of the NAS-built update.zip); the pattern below also matches it
out-hu/

# Partition payloads / rebuilt images
*.new.dat
*.new.dat.br
*.patch.dat
*.transfer.list
*.img

# AOSP / Lineage build trees and output (cloned separately, huge)
out/
prebuilts/
.AOSP
lineage/
aosp/

# editor noise
*.swp
.DS_Store

# local machine config and secrets — never commit credentials
local.env
*.env
.env.*
incoming/
