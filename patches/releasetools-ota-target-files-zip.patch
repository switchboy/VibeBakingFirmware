diff --git a/build/make/core/Makefile b/build/make/core/Makefile
--- a/build/make/core/Makefile
+++ b/build/make/core/Makefile
@@ -6936,12 +6936,17 @@
 # $(1): output file
 # $(2): additional args
+# Pass the target_files *zip* to ota_from_target_files, not the unpacked staging directory.
+# Android 14 strips the .zip here with $(patsubst %.zip,%), so the recipe hands over the staging
+# dir; non_ab_ota.py then re-zips that dir with Info-ZIP, which follows the tree's absolute and
+# dangling symlinks and reads the build host's own filesystem. Passing the zip makes
+# ota_from_target_files unzip only META/IMAGES/OTA - the path a release build takes.
 define build-ota-package-target
 PATH=$(INTERNAL_USERIMAGES_BINARY_PATHS):$(dir $(ZIP2ZIP)):$$PATH \
     $(OTA_FROM_TARGET_FILES) \
         --verbose \
         --path $(HOST_OUT) \
         --backup=$(backuptool) \
         $(if $(OEM_OTA_CONFIG), --oem_settings $(OEM_OTA_CONFIG)) \
         $(2) \
-        $(patsubst %.zip,%,$(BUILT_TARGET_FILES_PACKAGE)) $(1)
+        $(BUILT_TARGET_FILES_PACKAGE) $(1)
 endef
@@ -6975,5 +6980,8 @@
 $(INTERNAL_OTA_PACKAGE_TARGET): KEY_CERT_PAIR := $(DEFAULT_KEY_CERT_PAIR)
 $(INTERNAL_OTA_PACKAGE_TARGET): .KATI_IMPLICIT_OUTPUTS := $(INTERNAL_OTA_METADATA)
+# The recipe now reads the target_files zip, so the zip has to be a real dependency:
+# $(BUILT_TARGET_FILES_DIR) only guarantees the staged directory (add_img_to_target_files runs on
+# the dir, SOONG_ZIP builds the zip from the dir's file list afterwards). Without this, `m dist`
+# starts Package OTA while SOONG_ZIP is still writing the zip, and zipfile.is_zipfile() fails.
-$(INTERNAL_OTA_PACKAGE_TARGET): $(BUILT_TARGET_FILES_DIR) $(OTA_FROM_TARGET_FILES) $(INTERNAL_OTATOOLS_FILES)
+$(INTERNAL_OTA_PACKAGE_TARGET): $(BUILT_TARGET_FILES_PACKAGE) $(OTA_FROM_TARGET_FILES) $(INTERNAL_OTATOOLS_FILES)
 	@echo "Package OTA: $@"
 	$(call build-ota-package-target,$@,-k $(KEY_CERT_PAIR) --output_metadata_path $(INTERNAL_OTA_METADATA))
