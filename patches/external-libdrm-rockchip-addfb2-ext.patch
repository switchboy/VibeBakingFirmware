+/*
+ * Rockchip's BSP extension: the same ADDFB2 ioctl as drmModeAddFB2WithModifiers(), with the plane
+ * modifiers always copied in. Rockchip's libdrm fork exports this name and the vendor's composer
+ * blob (hwcomposer.rk30board.so, both arches) calls it, so Android 14's libdrm has to export it too.
+ * Declaration kept exactly as Rockchip published it - non-const arrays and __u64, not the const
+ * uint64_t style of the upstream neighbours above.
+ */
+extern int drmModeAddFB2_ext(int fd, uint32_t width, uint32_t height,
+			 uint32_t pixel_format, uint32_t bo_handles[4],
+			 uint32_t pitches[4], uint32_t offsets[4], __u64 modifier[4],
+			 uint32_t *buf_id, uint32_t flags);
