on early-fs
    setprop sys.usb.controller "fe800000.dwc3"
    setprop sys.usb.configfs 1

on fs && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/bcdDevice 0x0310
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1

# Always start console on userdebug and eng builds
on fs && property:ro.debuggable=1
    start console

service console /system/bin/sh
    console
    disabled
    seclabel u:r:shell:s0

# hu net module (D84/D85, Nov 21): independent oneshot services, each a small linear script with
# its own marker line in /cache/hu-mark.log and an internal kill-watchdog, so one hang cannot stall
# the others. Started on `on boot`: after ueventd has made /dev/block/by-name/* and init has mkdir'd
# /cache. Nothing here reboots - the recovery window stays open for the workstation.
service hu_early /sbin/hu-early.sh
    oneshot
    disabled
    seclabel u:r:shell:s0

service hu_hb /sbin/hu-hb.sh
    oneshot
    disabled
    seclabel u:r:shell:s0

service hu_state5 /sbin/hu-state.sh 5 /cache/state-recovery-5.txt
    oneshot
    disabled
    seclabel u:r:shell:s0

service hu_state30 /sbin/hu-state.sh 30 /cache/state-recovery-30.txt
    oneshot
    disabled
    seclabel u:r:shell:s0

service hu_state120 /sbin/hu-state.sh 120 /cache/state-recovery-120.txt
    oneshot
    disabled
    seclabel u:r:shell:s0

service hu_net /sbin/hu-net.sh
    oneshot
    disabled
    seclabel u:r:shell:s0

service hu_card /sbin/hu-card.sh
    oneshot
    disabled
    seclabel u:r:shell:s0

on boot
    start hu_early
    start hu_hb
    start hu_state5
    start hu_state30
    start hu_state120
    start hu_net
    start hu_card
