<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Day theme (spec S35): light, high-contrast for sunlight. -->
    <color name="bg">#F5EFE3</color>
    <color name="card_bg">#FFFFFF</color>
    <color name="text">#1B1B1B</color>
    <color name="text_sub">#4A4A4A</color>
    <color name="clock">#131313</color>          <!-- dark digits by day -->
    <color name="accent">#2F6D57</color>         <!-- static fallback accent (Material You wins if present) -->
    <color name="battery_ok">#2F6D57</color>
    <color name="battery_low">#C2432E</color>
    <color name="map_placeholder_bg">#E4D9C6</color>
    <!-- Engine gauge palette (owner 2026-11-27): LauncherActivity maps EngineGauges.Level ->
         these. gauge_ok reuses the day battery green. -->
    <color name="gauge_cold">#FF4FA3FF</color>   <!-- cold coolant/oil -->
    <color name="gauge_ok">#FF2F6D57</color>     <!-- nominal -->
    <color name="gauge_warn">#FFFFC83D</color>   <!-- watch band -->
    <color name="gauge_bad">#FFFF5A5A</color>    <!-- act now -->
    <!-- Settings number field fill (Round 6): the day card is already white (nothing can be
         lighter), so the day fill equals the card and the stroke separates it; at night the
         fill is lighter than the card. -->
    <color name="field_bg">#FFFFFFFF</color>
    <!-- Weather icon tints (owner 2026-11-27). The owner's hexes are chosen for the dark theme and
         are used verbatim at night; on the light day theme the pale ones (moon, snow) would be
         nearly invisible on #F5EFE3/#FFFFFF, so the day variants keep the same hue, darkened.
         Clouds/fog are text_sub in both themes, exactly as the owner asked. -->
    <color name="weather_sun">#FFB8860B</color>      <!-- warm amber, readable by day -->
    <color name="weather_moon">#FF64708C</color>     <!-- pale blue-grey, darkened -->
    <color name="weather_cloud">@color/text_sub</color>
    <color name="weather_fog">@color/text_sub</color>
    <color name="weather_rain">#FF2573C4</color>     <!-- blue, darkened -->
    <color name="weather_snow">#FF7FA8CC</color>     <!-- white-blue, darkened -->
    <color name="weather_thunder">#FFB8860B</color>  <!-- same amber as the sun -->
</resources>
