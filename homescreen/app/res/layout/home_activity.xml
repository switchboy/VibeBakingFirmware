<?xml version="1.0" encoding="utf-8"?>
<!-- Home layout for the 1024x600 landscape panel (spec S3/S5).
     Round 5 (owner request 2026-11-27): ▦ and ⚙ move out of the top-right row into the bottom
     strip beside the four-dot button (centred group, each 64dp, full strip height); the strip
     grows to 40dp so the glyphs match the dots. The volt meter moves up to a gauge row directly
     under the clock (voltage + engine temp + rpm, right-aligned, battery_size text). The radar
     card keeps the leftover column weight (min 120dp), so nothing clips at 1024x600: the gauge
     row costs ~24dp and the strip 8dp more than before, which the radar absorbs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="@dimen/card_margin">

        <FrameLayout
            android:id="@+id/map_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:layout_margin="@dimen/card_margin"
            android:background="@drawable/card_bg">
            <TextView
                android:id="@+id/map_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/map_placeholder"
                android:textColor="@color/text_sub"
                android:visibility="invisible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:orientation="vertical">

            <!-- Top-right row (Round 5): ▦/⚙ are gone (bottom strip), so clock + date use the
                 full column width; the date ellipsizes, the valet badge stays at the end.
                 Round 7 (owner request 2026-11-27): the weather icon (28dp) + outside temperature
                 sit right of the date, hidden until the first value. They are wrap_content at the
                 end of the row, so the shrinking child is the weighted date (which may ellipsize),
                 never the clock: ~120dp of free space measured on the panel, weather needs ~64dp. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">
                <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/clock" android:textSize="@dimen/clock_size" />
                <TextView android:id="@+id/clock_date" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp" android:textColor="@color/text_sub"
                    android:textSize="@dimen/date_size" android:maxLines="1" android:ellipsize="end" />
                <ImageView android:id="@+id/weather_icon" android:layout_width="@dimen/weather_icon_size"
                    android:layout_height="@dimen/weather_icon_size" android:layout_marginStart="12dp"
                    android:scaleType="fitCenter" android:src="@drawable/ic_wx_sun"
                    android:contentDescription="@string/weather_desc" android:visibility="gone" />
                <TextView android:id="@+id/weather_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:textColor="@color/text_sub" android:textSize="@dimen/date_size"
                    android:maxLines="1" android:visibility="gone" />
                <TextView android:id="@+id/valet_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" android:text="@string/valet_badge_text"
                    android:textColor="@color/battery_low" android:textSize="@dimen/badge_size" android:visibility="gone" />
            </LinearLayout>

            <!-- Engine gauges (owner 2026-11-27): one right-aligned row under the clock:
                 "12.6 V   88 °C   2150 rpm". Same id battery as before (updateBattery()
                 unchanged); colours come from EngineGauges.Level -> gauge_* (Round 5 policy),
                 not battery_ok/battery_low. temp/rpm stay GONE until a value arrives. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding">
                <TextView android:id="@+id/battery" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/gauge_ok" android:textSize="@dimen/battery_size"
                    android:visibility="gone" />
                <TextView android:id="@+id/engine_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:textColor="@color/gauge_ok" android:textSize="@dimen/battery_size"
                    android:visibility="gone" />
                <TextView android:id="@+id/engine_rpm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:textColor="@color/text_sub" android:textSize="@dimen/battery_size"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Media card: height now ~2/3 of before (~138dp -> ~88dp). Album art 64dp drives
                 the row height; transport buttons sit beside the text, and every label is one
                 ellipsized line (the long no-access message used to wrap and blow the card up,
                 clipping the radar card below). -->
            <LinearLayout
                android:id="@+id/media_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/card_margin"
                android:background="@drawable/card_bg"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">
                <ImageView android:id="@+id/media_art" android:layout_width="@dimen/art_size" android:layout_height="@dimen/art_size"
                    android:scaleType="centerCrop" android:src="@drawable/ic_music_placeholder" android:contentDescription="@string/media_idle" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="12dp" android:gravity="center_vertical" android:orientation="vertical">
                    <TextView android:id="@+id/media_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="18sp" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/media_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_sub" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/media_source" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_sub" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageButton android:id="@+id/media_prev" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_skip_prev" android:background="@android:color/transparent" android:contentDescription="@string/media_idle" />
                    <ImageButton android:id="@+id/media_play_pause" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_pause" android:background="@android:color/transparent" android:contentDescription="@string/media_idle" />
                    <ImageButton android:id="@+id/media_next" android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_skip_next" android:background="@android:color/transparent" android:contentDescription="@string/media_idle" />
                </LinearLayout>
            </LinearLayout>

            <!-- Radar card: keeps whatever is left of the column (weight), so its attribution
                 text no longer overflows the bottom of the screen; minHeight 120dp keeps it
                 usable even on a short panel (owner Round 5 floor). -->
            <FrameLayout
                android:id="@+id/radar_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="120dp"
                android:layout_margin="@dimen/card_margin"
                android:background="@drawable/card_bg">
                <org.vibebaking.launcher.RadarView
                    android:id="@+id/radar_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <TextView android:id="@+id/radar_attribution" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="bottom" android:padding="8dp" android:textColor="@color/text_sub" android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom strip (owner 2026-11-27): the centred [btn_apps] [fav_handle] [btn_settings]
         group, each 64dp wide and full strip height (40dp); same visual weight as the dots.
         The volt meter is no longer here (gauge row above). btn_settings keeps its id, so
         valet mode hides it exactly as before. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_strip_height"
        android:orientation="horizontal"
        android:gravity="center">
        <TextView android:id="@+id/btn_apps" android:layout_width="64dp" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/apps_glyph" android:textColor="@color/text"
            android:textSize="28sp" android:clickable="true" android:focusable="true" />
        <ImageView android:id="@+id/fav_handle" android:layout_width="64dp" android:layout_height="match_parent"
            android:src="@drawable/ic_four_dots" android:scaleType="center" android:clickable="true"
            android:focusable="true" android:contentDescription="@string/fav_handle_desc" />
        <TextView android:id="@+id/btn_settings" android:layout_width="64dp" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/settings_glyph" android:textColor="@color/text"
            android:textSize="28sp" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    </LinearLayout>

    <!-- Favourite row (spec S40) as an overlay over the cards, just above the strip; hidden until the four-dot
         button is pressed (LauncherActivity.toggleFavorites), hidden again after a launch or when home is left. -->
    <include layout="@layout/favorites_bar" />

</FrameLayout>
