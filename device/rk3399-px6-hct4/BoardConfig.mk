# Board config for the PX6 HU (RK3399, 4 GB RAM, Mali-T860). Deployed as
# device/rockchip/rk3399/BoardConfig.mk.

# ---- architecture -------------------------------------------------------------
# The HCT apps are partly 32-bit, so keep a compat ABI on arm64: arm64-v8a primary, armeabi-v7a
# secondary plus legacy armeabi. Soong's device config takes the abis from TARGET_CPU_ABI /
# TARGET_2ND_CPU_ABI (build/make/core/soong_config.mk:67,72) - leaving TARGET_2ND_CPU_ABI unset gives
# the arm arch an empty Abi list and the NDK prebuilt STL module panics in getNdkStlLibDir.
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_VARIANT := generic
TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-a
TARGET_2ND_CPU_VARIANT := generic
# Soong's device config takes the abi lists from TARGET_CPU_ABI/TARGET_2ND_CPU_ABI
# (build/make/core/soong_config.mk:67,72). Without TARGET_2ND_CPU_ABI the arm arch gets an empty Abi
# list and the NDK prebuilt STL module panics in getNdkStlLibDir.
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi

# ---- vendor image -------------------------------------------------------------
# Vendor is *built* from staged blobs, not prebuilt: the Android 14 OTA packer needs a real
# VENDOR/ staging directory, vendor.map and a vendor build.prop, none of which exist when
# BOARD_PREBUILT_VENDORIMAGE is used. scripts/prebuilt_vendor.sh extracts the Daisaita Android 11
# vendor partition into vendor/hct4/tree/vendor, and device.mk stages it through PRODUCT_COPY_FILES
# (generated by tools/gen_vendor_staging.py). The blobs are byte-identical to the stock image; the
# reference copy stays at vendor/hct4/prebuilt/vendor_a11.img for tools/vendor_diff.py.
# system / product / system_ext / odm come from source.
# No VNDK snapshots: Android 14 builds against the framework and talks to the vendor through the
# HALs declared in the vendor manifest (target-level 5). The stock device compatibility matrix is
# dropped because it declares vendor-ndk 30, which Android 14 does not support.
# BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE (below in the filesystem section) is what turns the staging
# directory into vendor.img.

# board_config.mk refuses a vendor image unless the copy-out names are explicit.
TARGET_COPY_OUT_VENDOR := vendor
TARGET_COPY_OUT_SYSTEM_EXT := system_ext
TARGET_COPY_OUT_PRODUCT := product
TARGET_COPY_OUT_ODM := odm

# The staged vendor blobs are ELF binaries and libraries, and Android 14 rejects ELF files passed
# through PRODUCT_COPY_FILES ("found ELF prebuilt in PRODUCT_COPY_FILES, use cc_prebuilt_binary /
# cc_prebuilt_library_shared instead", definitions.mk:3184 checks with llvm-readobj). Rebuilding
# ~1400 Rockchip blobs as cc_prebuilt modules is not the point here, so the check is turned off.
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true

# ---- platform -----------------------------------------------------------------
TARGET_NO_BOOTLOADER := true
TARGET_BOARD_PLATFORM := rk3399
TARGET_BOARD_PLATFORM_GPU := mali-t860mp2
TARGET_BOOTLOADER_BOARD_NAME := rk3399
# main.mk turns these into vendor props (ro.hwui.use_vulkan / ro.sf.lcd_density); setting them here
# avoids the duplicate-assignment error that assigning them in device.mk causes.
TARGET_USES_VULKAN := false      # Mali-T860 has no Vulkan driver; the HCT apps use GLES
TARGET_SCREEN_DENSITY := 240
# gralloc/allocator/mapper 4.0 from the A11 vendor tree hand out dmabuf fds, so no ION path
# and no libion shim (docs/decisions.md D4/D9).
TARGET_USES_ION := false

# ---- kernel -------------------------------------------------------------------
# 4.19.193 #24 from the Daisaita Android 11 package: binderfs, ION CMA heap, POSIX ACL, and
# CONFIG_MALI_MIDGARD=y built-in (so /dev/mali needs no .ko). Its vermagic also matches the
# vendor module set (WiFi 5 GHz chips + usb_f_iap.ko for CarPlay).
TARGET_PREBUILT_KERNEL := vendor/hct4/prebuilt/kernel_a11
BOARD_KERNEL_PAGESIZE := 2048
BOARD_KERNEL_BASE := 0x00000000
BOARD_KERNEL_CMDLINE := console=ttyFIQ0 androidboot.baseband=N/A androidboot.wificountrycode=NL androidboot.veritymode=disabled androidboot.hardware=rk30board androidboot.console=ttyFIQ0 androidboot.verifiedbootstate=orange firmware_class.path=/vendor/etc/firmware init=/init rootwait ro loop.max_part=7 androidboot.selinux=permissive buildvariant=userdebug
# wificountrycode=NL, not the vendor default CN: CN marks channels 12/13 "no IR" and 14
# disabled, which is exactly the 2.4 GHz-only behaviour we measured on the unit.

# ---- WiFi HAL glue (**D21**) --------------------------------------------------
# Android 14 chooses the WiFi driver glue through the `wifi` Soong config namespace
# (build/make/core/board_config_wifi.mk -> frameworks/opt/net/wifi/libwifi_hal/Android.bp). Left
# unset, Soong takes `conditions_default` and installs libwifi-hal-fallback (wifi_hal_fallback.cpp),
# whose wifi_initialize reports "unsupported" - the unit then has no WiFi at all, not degraded WiFi.
# `realtek` pulls in libwifi-hal-rtk, built from the published Realtek/Rockchip glue in
# device/rockchip/rk3399/wifi_hal; it compiles for arm64 and arm against Android 14's libnl unchanged.
# This unit's chip is a USB RTL8188ETV (modalias usb:v0BDAp0179), which Rockchip's own chip table maps
# to exactly this HAL. The driver module values below feed -DWIFI_DRIVER_MODULE_* and
# load_wifi_module(); hu_insmod.sh insmods the .ko earlier in boot, so they only say where it lives.
# WIFI_DRIVER_MODULE_ARG is left undeclared on purpose: the driver takes no module parameters.
BOARD_WLAN_DEVICE := realtek
# These become -DWIFI_DRIVER_MODULE_* macros (frameworks/opt/net/wifi/libwifi_hal/wifi_hal_common.cpp
# uses them as string literals and sizeof()s them), and build/make/core/board_config_wifi.mk passes the
# value into Soong's config JSON verbatim - so the quotes must be part of the Make value, without
# backslashes. Unquoted gives `-DWIFI_DRIVER_MODULE_NAME=8188eu` ("sizeof on incomplete type"), and
# \"-escaped gives invalid JSON ("soong.variables did not parse correctly").
WIFI_DRIVER_MODULE_NAME := "8188eu"
WIFI_DRIVER_MODULE_PATH := "/vendor/lib/modules/8188eu.ko"

# The supplicant and hostapd binaries are Make-built (`external/wpa_supplicant_8/Android.mk` line 3
# only includes the two Android.mks when WPA_SUPPLICANT_VERSION is VER_0_8_X or VER_2_1_DEVEL), which
# is why `m` complained "includes non-existent modules in PRODUCT_PACKAGES: hostapd wpa_supplicant".
# hostapd's AIDL variant needs no flag (hostapd/Android.mk sets HOSTAPD_USE_AIDL=y itself at line
# 1152), but the supplicant's service .rc is behind WIFI_HIDL_UNIFIED_SUPPLICANT_SERVICE_RC_ENTRY
# (wpa_supplicant/Android.mk:1980) - without it the service installs without an init entry.
WPA_SUPPLICANT_VERSION := VER_0_8_X
BOARD_WPA_SUPPLICANT_DRIVER := NL80211
BOARD_HOSTAPD_DRIVER := NL80211
WIFI_HIDL_UNIFIED_SUPPLICANT_SERVICE_RC_ENTRY := true

# ---- boot / recovery ----------------------------------------------------------
# Partition sizes taken from the live unit's /proc/partitions: boot = 32768 KiB (mmcblk2p7),
# recovery = 98304 KiB (mmcblk2p8). Without these the build emits no boot.img/recovery.img at all
# (build/make/core/Makefile:1282 gates the boot image on BOARD_BOOTIMAGE_PARTITION_SIZE).
BOARD_BOOTIMAGE_PARTITION_SIZE := 33554432
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 100663296
# The images are ext4 with 4096-byte blocks, so the OTA's block operations use 4096 too. 512 makes
# blockimgdiff's transfer lists 8x larger for no benefit; it is only ever 512 on MTD devices.
BOARD_FLASH_BLOCK_SIZE := 4096
BOARD_BOOT_HEADER_VERSION := 2
BOARD_USES_RECOVERY_AS_BOOT := false      # the HU has its own recovery partition (mmcblk2p8)
# Do NOT declare BOARD_INCLUDE_RECOVERY_DTBO at all: the Makefile tests it with `ifdef`, so setting
# it to `false` still emits `--recovery_dtbo` with an empty value and mkbootimg aborts.

# Load addresses are read straight from the vendor's working boot.img (unpack_bootimg on
# analysis/daisaita_a11/boot/boot.img), so the vendor u-boot loads our image the same way:
#   kernel 0x10008000  ramdisk 0x11000000  second 0x10f00000  tags 0x10000100  dtb 0x11f00000
# The Makefile only passes --base/--pagesize/--cmdline; every offset has to come from here. It also
# never passes --header_version, so BOARD_BOOT_HEADER_VERSION alone gives header v0 - which cannot
# carry a DTB at all (our first boot.img came out header_version 0 with no dtb). Pass it explicitly.
BOARD_MKBOOTIMG_ARGS := --header_version 2 \
                        --kernel_offset 0x10008000 \
                        --ramdisk_offset 0x11000000 \
                        --second_offset 0x10f00000 \
                        --tags_offset 0x10000100 \
                        --dtb_offset 0x0000000011f00000 \
                        --second device/rockchip/rk3399/prebuilt/boot_second_logo.bin

# The vendor u-boot expects the DTB inside boot.img (the A11 boot.img embeds it; there is no
# separate dtb load step on this board's boot path). `second` is the Rockchip RSCE boot logo,
# which is what the vendor boot.img carries in the second-stage field - no `logo` partition exists
# on this unit, so keeping it preserves the boot animation.
BOARD_INCLUDE_DTB_IN_BOOTIMG := true
BOARD_PREBUILT_DTBIMAGE_DIR := device/rockchip/rk3399/prebuilt/dtb

BOARD_USE_DYNAMIC_PARTITIONS := true
BOARD_BUILD_SUPER_IMAGE_BY_DEFAULT := true

# ---- dynamic partitions (super) -----------------------------------------------
# p14's size must match BOARD_SUPER_PARTITION_SIZE exactly, or super's metadata disagrees with the
# partition and Android refuses to boot.
#
# The layout is NOT changed (D19, owner Nov 6; superseding D8's "grow super to 8 GiB"): p14 stays
# 3186688 KiB = 3,263,168,512 B, which is what the probe measured in
# analysis/hu_partition_offsets.txt. Android 14's logical images are block-aligned to
# 2,183,183,264 B (system 929.1 + vendor 412.1 + product 456.4 + system_ext 384.8 + odm 0.8 MB), so
# they fit inside the 3,258,974,208 B group with ~1.07 GiB spare - less than the stock Android 10
# layout's 3,125,321,728 B. The install recreates the logical partitions inside super through the
# payload's dynamic_partitions_op_list and never writes the partition table (docs/flash.md, D18).
#
# The rejected alternative, recorded for the day the images outgrow the group: super 8 GiB
# (BOARD_SUPER_PARTITION_SIZE := 8589934592, BOARD_HCT_DYNAMIC_PARTITIONS_SIZE := 8585710080) with
# userdata shrunk to ~49.84 GiB. That needs a GPT rewrite, which is a fresh risk decision, not a
# routine step.
BOARD_SUPER_PARTITION_SIZE := 3263168512
BOARD_SUPER_PARTITION_GROUPS := hct_dynamic_partitions
BOARD_HCT_DYNAMIC_PARTITIONS_SIZE := 3258974208    # super minus 4 MiB metadata overhead
BOARD_HCT_DYNAMIC_PARTITIONS_PARTITION_LIST := system vendor product system_ext odm

# ---- filesystem ---------------------------------------------------------------
# The HU has a 384 MiB `cache` partition (mmcblk2p11). Non-A/B OTAs need it: ota_from_target_files
# asserts on cache_size (blockimgdiff.py:1547 splits transfers and stashes source blocks against it).
# misc_info.txt only gets cache_size when a cache image is actually built (build/make/core/Makefile
# emits it inside the cache partition's prop block), so both the size and the fs type are declared;
# cache.img comes out ~2 MB sparse and the wipe step erases it. Recovery formats it via the fstab.
BOARD_CACHEIMAGE_PARTITION_SIZE := 402653184
BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4

# The HU has a 16 MiB `metadata` partition (mmcblk2p12, mounted at /metadata on the stock
# firmware). update_engine and vold use it (OTA metadata + /metadata/vold/metadata_encryption),
# and the OTA's wipe step erases it, so declare it.
BOARD_USES_METADATA_PARTITION := true
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_ODMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true

# ---- trust / SELinux ----------------------------------------------------------
# The stock firmware boots verifiedbootstate=orange and SELinux permissive; we keep
# permissive for the framework-only boot test (M3) and tighten sepolicy afterwards.
BOARD_AVB_ENABLE := false
WITH_PERMISSIVE_SELINUX := true
