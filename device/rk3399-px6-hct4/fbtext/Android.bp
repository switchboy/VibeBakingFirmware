// Panel painter: hu_fblog, the old-school scrolling boot log on the head-unit panel.
//
// Why this is a module and not a PRODUCT_COPY_FILES entry: it has to be compiled, and the repo keeps
// its sources in the device dir so scripts/deploy_device.sh copies them into the tree (that script
// also checks every referenced path exists before a build starts).
//
// hu_fblog.c paints /dev/kmsg and logcat onto /dev/fb0 while there is no SurfaceFlinger yet - the OEM
// kernel has no CONFIG_FRAMEBUFFER_CONSOLE/CONFIG_VT, so kernel-side fbcon cannot show anything. The
// font header beside it is generated by tools/make_fb_font.py and committed here, so the build reads
// exactly the bytes whose sha256 is recorded in docs/flash.md.
//
// The service definition is in configs/init.hu.rc (installed as /vendor/etc/init/hu.rc), not in an
// init: property here - hu.rc is where hu_sdlog and the TCP-adb trigger live too, and it stops this
// service as soon as SurfaceFlinger starts.
cc_binary {
    name: "hu_fblog",
    srcs: ["hu_fblog.c"],
    cflags: ["-Wall"],
    // Root, because /dev/fb0 is root-owned; init starts it as user root under permissive bring-up
    // SELinux (androidboot.selinux=permissive). It is a bring-up aid, not part of the release image.
}
