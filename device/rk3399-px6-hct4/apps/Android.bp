// Prebuilt head-unit apps from the reference Android 10 payload (Microntek/HCT), staged as real
// build modules so they land in the image instead of being copied by hand.
//
// Why a module and not PRODUCT_COPY_FILES: build/make/core/Makefile:118 refuses a `.apk`
// destination in PRODUCT_COPY_FILES ("Prebuilt apk found in PRODUCT_COPY_FILES"), so the only way to
// install an apk is a module - this is the same route prebuilt_apps/Android.mk takes for the stock
// vendor resource-overlay, just with Soong's android_app_import.
//
// `apk:` is the source path relative to this folder (there is no `prebuilt:` property on
// android_app_import); the blobs live here in the repo device dir so scripts/deploy_device.sh copies
// them into the tree and checks they exist.
//
// `certificate: "platform"` re-signs every apk with the platform key this build signs its own system
// apps with (build/make/target/product/security/platform.x509.pem - cert digest
// c8a2e9bccf597c2fb6dc66bee293fc13f2fc47ec77bc6b2b0d52c11f51192ab8, which is what framework-res.apk,
// SystemUI.apk and Settings.apk carry). Seven of these apks declare android:sharedUserId="android.uid.system"
// and PackageManager refuses an apk that claims a system shared uid while signed by anyone else; the
// rest are signed with the same key so the signature permissions between the HCT apps keep working
// (android.permission.HCT_FACTORY is declared by HCTFactorySettings and used by the others). The
// payload's own signature is a different Android key (digest 2d370c21f5dfd553d2a796314b70925fb38adeef90864c920bbbbb12887d3522),
// so byte-for-byte fidelity is deliberately broken here - see docs/decisions.md D24.
//
// dex_preopt is off: Android 14 dexopts at boot, and shipping Android 10's `oat/` directories from the
// payload would put dex files next to a runtime that cannot use them.
//
// Everything installed here targets API 22..29 on purpose (they were built against Android 10). Apps
// keep the framework behaviour of their target SDK, which is what the OEM code expects; the risk that
// a specific Android 10 framework API is gone is listed in D24 rather than fixed here.

android_app_import {
    name: "HCT4Radio",
    apk: "system/HCT4Radio/HCT4Radio.apk",
    certificate: "platform",
    dex_preopt: { enabled: false },
}

android_app_import {
    name: "HCT4Music",
    apk: "system/HCT4Music/HCT4Music.apk",
    certificate: "platform",
    dex_preopt: { enabled: false },
}

