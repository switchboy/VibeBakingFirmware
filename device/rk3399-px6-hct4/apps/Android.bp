    name: "HCT4FileBrowser",
    apk: "system/HCT4FileBrowser/HCT4FileBrowser.apk",
    certificate: "platform",
    dex_preopt: { enabled: false },
}

android_app_import {
    name: "HCT4BlueTooth",
    apk: "system/HCT4BlueTooth/HCT4BlueTooth.apk",
    certificate: "platform",
    dex_preopt: { enabled: false },
}

android_app_import {
    name: "HCT4BtMusic",
