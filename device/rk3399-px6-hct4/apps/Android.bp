// ---- privileged apps (installed into /system/priv-app) ---------------------------
// privileged: true is what grants the signature|privileged permissions; those have to appear in
// /system/etc/permissions/privapp-permissions-hct.xml (copied by hu_apps.mk) or the framework logs
// "permission X not in whitelisting" - enforcement is log-only on a userdebug build.

android_app_import {
    name: "HCTBlueToothManager",
    apk: "priv-app/HCTBlueToothManager/HCTBlueToothManager.apk",
    privileged: true,
    certificate: "platform",
    dex_preopt: { enabled: false },
}

// package android.microntek.canbus - the CANBUS/MCU bridge (reads /dev/mtc-car and the goc serial).
android_app_import {
